{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optic-ray.local/schemas/viewport_scene.schema.json",
  "title": "Optic Ray Viewport Scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "scenario_id",
    "config_hash",
    "model_scope",
    "components",
    "ports",
    "guides",
    "rays",
    "footprints",
    "meshes",
    "mesh_hits",
    "constraints",
    "placement_edits",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "project_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "scenario_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "model_scope": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewportComponent" }
    },
    "ports": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewportPort" }
    },
    "guides": {
      "type": "array",
      "items": { "$ref": "#/$defs/guideLine" }
    },
    "rays": {
      "type": "array",
      "items": { "$ref": "#/$defs/raySegment" }
    },
    "footprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/footprintOverlay" }
    },
    "meshes": {
      "type": "array",
      "items": { "$ref": "#/$defs/viewportMesh" }
    },
    "mesh_hits": {
      "type": "array",
      "items": { "$ref": "#/$defs/meshHitOverlay" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/placementConstraint" }
    },
    "placement_edits": {
      "type": "array",
      "items": { "$ref": "#/$defs/placementEdit" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "mat3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "number" }
      }
    },
    "viewportComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "component_ref",
        "component_type",
        "model_level",
        "origin_world_m",
        "rotation_world_from_component",
        "bounds_m",
        "display_role",
        "selectable",
        "editable"
      ],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "component_ref": { "type": "string", "minLength": 1 },
        "component_type": { "type": "string", "minLength": 1 },
        "model_level": { "type": "string", "minLength": 1 },
        "origin_world_m": { "$ref": "#/$defs/vec3" },
        "rotation_world_from_component": { "$ref": "#/$defs/mat3" },
        "bounds_m": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/vec3" }
            }
          ]
        },
        "display_role": { "type": "string", "minLength": 1 },
        "selectable": { "type": "boolean" },
        "editable": { "type": "boolean" }
      }
    },
    "viewportPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "port_id",
        "role",
        "interface_type",
        "reference_plane",
        "origin_world_m",
        "axis_world",
        "transverse_x_world",
        "clear_aperture_m"
      ],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "port_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "interface_type": { "type": "string", "minLength": 1 },
        "reference_plane": { "type": "string", "minLength": 1 },
        "origin_world_m": { "$ref": "#/$defs/vec3" },
        "axis_world": { "$ref": "#/$defs/vec3" },
        "transverse_x_world": { "$ref": "#/$defs/vec3" },
        "clear_aperture_m": { "type": ["number", "null"], "minimum": 0.0 }
      }
    },
    "guideLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guide_id",
        "guide_type",
        "start_m",
        "end_m",
        "color",
        "label",
        "enabled",
        "source",
        "metadata"
      ],
      "properties": {
        "guide_id": { "type": "string", "minLength": 1 },
        "guide_type": { "type": "string", "minLength": 1 },
        "start_m": { "$ref": "#/$defs/vec3" },
        "end_m": { "$ref": "#/$defs/vec3" },
        "color": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "enabled": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/guideMetadata" }
      }
    },
    "guideMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plane_id": { "type": "string", "minLength": 1 },
        "actual_hit_m": { "$ref": "#/$defs/vec3" },
        "expected_center_m": { "$ref": "#/$defs/vec3" },
        "lateral_residual_m": { "type": ["number", "null"], "minimum": 0.0 },
        "angular_residual_rad": { "type": ["number", "null"], "minimum": 0.0 },
        "aperture_status": { "type": ["string", "null"] },
        "geometry_only": { "type": "boolean" },
        "fiber_coupling_model": { "type": ["string", "null"] },
        "fiber_coupling_status": { "type": ["string", "null"] },
        "fiber_coupling_efficiency": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "power_coupled_into_fiber_w": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "coherent_field_status": { "type": ["string", "null"] },
        "field_usable_for_coherent_propagation": { "type": ["boolean", "null"] },
        "detector_boundary_model": { "type": ["string", "null"] },
        "detector_input_status": { "type": ["string", "null"] },
        "power_at_detector_input_w": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "fiber_coupled_to_detector_input_link_loss_db": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "target_to_detector_input_link_loss_db": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "source_to_detector_input_round_trip_link_loss_db": {
          "type": ["number", "null"],
          "minimum": 0.0
        },
        "detector_response_status": { "type": ["string", "null"] },
        "detector_coherent_field_status": { "type": ["string", "null"] },
        "detector_field_usable_for_coherent_propagation": {
          "type": ["boolean", "null"]
        }
      }
    },
    "raySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "start_m",
        "end_m",
        "direction",
        "optical_path_id",
        "source_element_id",
        "target_element_id",
        "power_w",
        "radius_start_m",
        "radius_end_m",
        "length_m",
        "status",
        "label",
        "propagation_role",
        "plane_power_name"
      ],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "start_m": { "$ref": "#/$defs/vec3" },
        "end_m": { "$ref": "#/$defs/vec3" },
        "direction": { "$ref": "#/$defs/vec3" },
        "optical_path_id": { "type": "string", "minLength": 1 },
        "source_element_id": { "type": "string", "minLength": 1 },
        "target_element_id": { "type": ["string", "null"] },
        "power_w": {
          "oneOf": [
            { "type": "number", "minimum": 0.0 },
            { "type": "null" }
          ]
        },
        "radius_start_m": { "type": ["number", "null"], "exclusiveMinimum": 0.0 },
        "radius_end_m": { "type": ["number", "null"], "exclusiveMinimum": 0.0 },
        "length_m": { "type": "number", "minimum": 0.0 },
        "status": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "propagation_role": {
          "enum": ["transmit", "return", "planned_return"]
        },
        "plane_power_name": { "type": ["string", "null"] }
      }
    },
    "footprintOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "hit_center_m",
        "normal",
        "major_radius_m",
        "minor_radius_m",
        "major_axis_world",
        "minor_axis_world",
        "orientation_axis_world",
        "axis_convention",
        "area_m2",
        "power_on_target_w",
        "clipped_by_target_bounds",
        "status"
      ],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "hit_center_m": { "$ref": "#/$defs/vec3" },
        "normal": { "$ref": "#/$defs/vec3" },
        "major_radius_m": { "type": "number", "exclusiveMinimum": 0.0 },
        "minor_radius_m": { "type": "number", "exclusiveMinimum": 0.0 },
        "major_axis_world": { "$ref": "#/$defs/vec3" },
        "minor_axis_world": { "$ref": "#/$defs/vec3" },
        "orientation_axis_world": { "$ref": "#/$defs/vec3" },
        "axis_convention": {
          "const": "unit_orthogonal_right_handed_major_minor_target_normal"
        },
        "area_m2": { "type": "number", "exclusiveMinimum": 0.0 },
        "power_on_target_w": { "type": "number", "minimum": 0.0 },
        "clipped_by_target_bounds": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "viewportMesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "asset_id",
        "material_ref",
        "triangles_world_m",
        "source_triangle_count",
        "display_triangle_count",
        "display_triangle_indices",
        "display_triangle_limit",
        "display_selection",
        "decimated",
        "geometry_semantics"
      ],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "material_ref": { "type": "string", "minLength": 1 },
        "triangles_world_m": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "$ref": "#/$defs/vec3" }
          }
        },
        "source_triangle_count": { "type": "integer", "minimum": 1 },
        "display_triangle_count": { "type": "integer", "minimum": 1 },
        "display_triangle_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "display_triangle_limit": { "type": "integer", "minimum": 1 },
        "display_selection": {
          "enum": [
            "all",
            "deterministic_evenly_spaced_with_reported_hit_preservation"
          ]
        },
        "decimated": { "type": "boolean" },
        "geometry_semantics": { "const": "geometry_only_not_optical_scatterers" }
      }
    },
    "meshHitOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "asset_id",
        "point_m",
        "geometric_normal",
        "normal_end_m",
        "distance_m",
        "triangle_index",
        "front_face",
        "face",
        "contributes_to_center_ray_visibility",
        "visibility_status",
        "source",
        "geometry_only",
        "status"
      ],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "point_m": { "$ref": "#/$defs/vec3" },
        "geometric_normal": { "$ref": "#/$defs/vec3" },
        "normal_end_m": { "$ref": "#/$defs/vec3" },
        "distance_m": { "type": "number", "exclusiveMinimum": 0.0 },
        "triangle_index": { "type": "integer", "minimum": 0 },
        "front_face": { "type": "boolean" },
        "face": { "enum": ["front", "back"] },
        "contributes_to_center_ray_visibility": { "type": "boolean" },
        "visibility_status": { "type": "string", "minLength": 1 },
        "source": { "const": "phase4_1_m1_report" },
        "geometry_only": { "const": true },
        "status": { "const": "hit" }
      }
    },
    "placementConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "constraint_type",
        "enabled",
        "source_ref",
        "target_ref",
        "parameters",
        "residual",
        "status",
        "warnings"
      ],
      "properties": {
        "constraint_id": { "type": "string", "minLength": 1 },
        "constraint_type": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "source_ref": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "residual": { "type": ["number", "null"] },
        "status": { "type": "string", "minLength": 1 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placementEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edit_id",
        "element_id",
        "edit_type",
        "before_transform",
        "after_transform",
        "source",
        "timestamp",
        "validation_status",
        "serialized_config_patch"
      ],
      "properties": {
        "edit_id": { "type": "string", "minLength": 1 },
        "element_id": { "type": "string", "minLength": 1 },
        "edit_type": { "type": "string", "minLength": 1 },
        "before_transform": { "type": "object", "additionalProperties": true },
        "after_transform": { "type": "object", "additionalProperties": true },
        "source": { "type": "string", "minLength": 1 },
        "timestamp": { "type": ["string", "null"] },
        "validation_status": { "type": "string", "minLength": 1 },
        "serialized_config_patch": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
